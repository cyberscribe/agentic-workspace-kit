{
  "extraKnownMarketplaces": {
    "agentic-workspace": {
      "source": __MARKETPLACE_SOURCE__
    }
  },
  "enabledPlugins": {
    "closeout@agentic-workspace": true,
    "projects@agentic-workspace": true,
    "workspace@agentic-workspace": true
  },
  "permissions": {
    "allow": [
      "Bash(rm *closeout-drafts*)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.claude/closeout-drafts"
      ]
    }
  }
}
