{
  "description": "Closeout plugin — SessionEnd capture of unrecorded learnings, SessionStart review of pending drafts.",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/closeout-capture.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/closeout-review.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
