#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# githooks/pre-push: git passes the remote's name and URL as arguments, and one line per ref on stdin:
# <local ref> <local sha> <remote ref> <remote sha>.
#
#   kit        every commit each ref sends, one at a time, through scripts/check-paths.sh with the
#              content rules; with aw.mirror.<remote>.prefix set (a subtree mirror), paths are judged
#              under that prefix. The kit is public, so there is no visibility rule here.
#   workspace  the remote has to be confirmed private: GitHub says so (gh), or it is listed under
#              Private remotes in .claude/workspace.md, or it is a local path under the temporary
#              folder. AW_ALLOW_PUBLIC=<normalised remote> pushes once regardless.
#   project    confirmed private as above, or listed as a Public remote in .claude/workspace.md on a
#              line that names this project's folder, for a project whose README.md or CLAUDE.md
#              does not say Sensitivity: sensitive.
#
# Then the user's own pre-push runs, with the same arguments and the same stdin.
set -uo pipefail
# shellcheck source=lib/common.sh
if ! . "$(dirname "$0")/lib/common.sh"; then
    printf 'aw pre-push: could-not-run: githooks/lib/common.sh cannot be read.\nNothing was pushed.\n' >&2
    exit 1
fi
awh_start pre-push "$@"
remote="${1:-}" url="${2:-${1:-}}"
case "$AWH_CONTEXT" in
    kit)
        prefix="$(git config --get "aw.mirror.$remote.prefix" 2>/dev/null)"
        while read -r lref lsha rref rsha; do
            [[ -n "${lsha:-}" ]] || continue
            ref="$rref"
            case "$lref" in refs/notes/*) ref="$lref" ;; esac
            if [[ -n "$prefix" ]]; then
                awh_checkpaths --prefix "$prefix" --content --workspace "$AWH_WS" --ref "$ref" --push "$remote" "$lsha" "$rsha"
            else
                awh_checkpaths --content --workspace "$AWH_WS" --ref "$ref" --push "$remote" "$lsha" "$rsha"
            fi
        done < "$AWH_TMP/stdin" ;;
    workspace)
        awh_workspace_prepush "$remote" "$url" ;;
    project)
        awh_project_prepush "$remote" "$url" ;;
esac
awh_verdict
awh_chain
